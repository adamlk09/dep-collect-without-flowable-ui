# Valeurs pour un usage LOCAL uniquement (portable). Ne pas utiliser en production.
# Usage: copier ce fichier en ".env" puis: docker compose up -d
MICRO_DB_PASSWORD=collector
COLLECT_DB_PASSWORD=collect_pass
SERVICE_TOKEN=local-dev-service-token
TENANT_ID=mercure
# E-mails captures par Mailpit (interface: http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Application: http://localhost:8080
FRONTEND_PORT=8080
